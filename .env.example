# Settings for the live AI advisor. Copy to .env (or .dev.vars for `wrangler dev`); both are gitignored.
# In production these are Cloudflare secrets or vars: npx wrangler secret put ANTHROPIC_API_KEY

# Optional. Leave unset to run the advisor in free, deterministic built-in mode.
# When set, the advisor calls Claude. Server-side only; never exposed to the browser.
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-opus-5-5.
ADVISOR_MODEL=

# Optional daily spend cap for live answers, in US dollars. Defaults to 5 (also set in wrangler.jsonc).
ADVISOR_DAILY_BUDGET_USD=

# Optional extra origins allowed to call the advisor, comma-separated (for example a local preview).
ADVISOR_ALLOWED_ORIGINS=
